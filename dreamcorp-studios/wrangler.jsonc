{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dreamcorp-studios",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "workers_dev": true,
  // Accounts, sessions, usage counts and generated images.
  "kv_namespaces": [{ "binding": "DC_KV", "id": "4c3d01cb515b4dd5b215166daa46fcd3" }],
  // Cloudflare Workers AI: the built-in image models. No outside API key needed.
  "ai": { "binding": "AI" }
}
